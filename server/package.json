{
  "name": "server",
  "version": "1.1.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "prisma generate && tsx watch src/index.ts",
    "build": "prisma generate && tsc",
    "start": "node dist/src/index.js",
    "seed": "tsx prisma/seed.ts",
    "seed:adam:csv": "tsx scripts/seedAdamFromCsv.ts",
    "report:main-vs-adam": "tsx scripts/reportMainVsAdam.ts",
    "apply:main-from-adam": "tsx scripts/applyMainFromAdam.ts",
    "reconcile:main-adam:report": "tsx scripts/reconcileMainAdamFromReport.ts",
    "flag:main:tracked": "tsx scripts/flagTrackedByUsage.ts --tenant=main",
    "flag:adam:tracked": "tsx scripts/flagTrackedByUsage.ts --tenant=adam",
    "sync:tracked:to-adam": "tsx scripts/syncTrackedToAdam.ts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "db:init": "npx prisma migrate deploy && npm run seed",
    "db:init:tenants": "tsx scripts/dbInitTenants.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "keywords": [],
