// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Location {
  id                   String                 @id @default(uuid())
  name                 String                 @unique
  description          String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  inventoryItems       InventoryItem[]
  transactionsFrom     InventoryTransaction[] @relation("FromLocation")
  transactionsTo       InventoryTransaction[] @relation("ToLocation")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                  String                 @id @default(uuid())
  name                String
  description         String?
  sku                 String?                @unique
  color               String?
  unitSize            String?
  manufacturer        String?
  categoryId          String?
  category            Category?              @relation(fields: [categoryId], references: [id])
  imageUrl            String?
  notes               String?
  // Reorder management fields
  reorderPoint        Int?                   // Trigger reorder alert when total qty falls below this
  maxStockLevel       Int?                   // Optional maximum to prevent over-ordering
  leadTimeDays        Int                    @default(7) // Days from order to delivery
  supplierType        String                 @default("OPEN_SOURCE") // GARAGE_FORCE_REQUIRED, GARAGE_FORCE_OPTIONAL, OPEN_SOURCE
  averageUsagePerJob  Float?                 // Estimated consumption per job
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt
  inventoryItems      InventoryItem[]
  transactions        InventoryTransaction[]
}

model InventoryItem {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  quantity    Int       @default(1)
  batchNumber String?
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InventoryTransaction {
  id              String    @id @default(uuid())
  productId       String
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactionType String    // RECEIPT, CONSUMPTION, TRANSFER, ADJUSTMENT
  fromLocationId  String?
  fromLocation    Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId    String?
  toLocation      Location? @relation("ToLocation", fields: [toLocationId], references: [id])
  quantity        Float     // Using Float to support decimal quantities
  jobReference    String?   // Simple text field for job name/ID
  notes           String?
  createdAt       DateTime  @default(now())

  @@index([productId, createdAt])
  @@index([transactionType])
}
