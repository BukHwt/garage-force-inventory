// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Location {
  id               String                 @id @default(uuid())
  name             String                 @unique
  description      String?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  inventoryItems   InventoryItem[]
  transactionsFrom InventoryTransaction[] @relation("FromLocation")
  transactionsTo   InventoryTransaction[] @relation("ToLocation")
}

model Category {
  id        String    @id @default(uuid())
  name      String    @unique
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  products  Product[]
}

model Product {
  id                 String                 @id @default(uuid())
  name               String
  description        String?
  sku                String?                @unique
  vendorPartNumber   String?
  color              String?
  unitSize           String?
  manufacturer       String?
  categoryId         String?
  category           Category?              @relation(fields: [categoryId], references: [id])
  imageUrl           String?
  notes              String?
  // Product structure fields
  productType        String                 @default("simple") // simple, kit, component, variant_parent
  consumableType     ProductConsumableType  @default(REUSABLE)
  parentProductId    String? // For variants: links to parent product
  parentProduct      Product?               @relation("ProductVariants", fields: [parentProductId], references: [id], onDelete: Cascade)
  variants           Product[]              @relation("ProductVariants")
  isTracked          Boolean                @default(false)
  // Reorder management fields
  reorderPoint       Int? // Trigger reorder alert when total qty falls below this
  maxStockLevel      Int? // Optional maximum to prevent over-ordering
  leadTimeDays       Int                    @default(7) // Days from order to delivery
  supplierType       String                 @default("OPEN_SOURCE") // GARAGE_FORCE_REQUIRED, GARAGE_FORCE_OPTIONAL, OPEN_SOURCE
  averageUsagePerJob Float? // Estimated consumption per job
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt
  inventoryItems     InventoryItem[]
  transactions       InventoryTransaction[]
  // Kit relationships
  kitComponents      ProductComponent[]     @relation("KitProduct")
  componentOf        ProductComponent[]     @relation("ComponentProduct")

  @@index([vendorPartNumber])
}

enum ProductConsumableType {
  REUSABLE
  SINGLE_USE
}

model InventoryItem {
  id          String    @id @default(uuid())
  productId   String
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  locationId  String
  location    Location  @relation(fields: [locationId], references: [id])
  quantity    Int       @default(1)
  status      String    @default("SEALED") // SEALED or OPEN - tracks container status
  batchNumber String?
  expiresAt   DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model InventoryTransaction {
  id                String    @id @default(uuid())
  productId         String
  product           Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  transactionType   String // RECEIPT, CONSUMPTION, TRANSFER, ADJUSTMENT
  fromLocationId    String?
  fromLocation      Location? @relation("FromLocation", fields: [fromLocationId], references: [id])
  toLocationId      String?
  toLocation        Location? @relation("ToLocation", fields: [toLocationId], references: [id])
  quantity          Float // Using Float to support decimal quantities
  jobReference      String? // Simple text field for job name/ID
  notes             String?
  createdAt         DateTime  @default(now())
  performedByUserId String?
  performedBy       User?    @relation("TransactionPerformedBy", fields: [performedByUserId], references: [id])
  isReverted        Boolean   @default(false)
  revertedAt        DateTime?
  revertedByUserId  String?
  revertedBy        User?     @relation("TransactionRevertedBy", fields: [revertedByUserId], references: [id])

  @@index([productId, createdAt])
  @@index([transactionType])
  @@index([performedByUserId])
  @@index([isReverted])
}

model ProductComponent {
  id                 String   @id @default(uuid())
  kitProductId       String // The kit/bundle product
  kitProduct         Product  @relation("KitProduct", fields: [kitProductId], references: [id], onDelete: Cascade)
  componentProductId String // The component product (e.g., Part A, Part B)
  componentProduct   Product  @relation("ComponentProduct", fields: [componentProductId], references: [id], onDelete: Cascade)
  quantityRequired   Int      @default(1) // How many of this component are needed
  isOptional         Boolean  @default(false) // For alternative components (e.g., choose one Part B variant)
  componentLabel     String? // e.g., "Part A", "Part B", "Hardener"
  sortOrder          Int      @default(0) // For displaying components in order
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@unique([kitProductId, componentProductId])
  @@index([kitProductId])
  @@index([componentProductId])
}

model User {
  id                   String                  @id @default(uuid())
  name                 String
  role                 UserRole                @default(TECH)
  pinHash              String
  isActive             Boolean                 @default(true)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  transactions         InventoryTransaction[]  @relation("TransactionPerformedBy")
  revertedTransactions InventoryTransaction[]  @relation("TransactionRevertedBy")
}

enum UserRole {
  OWNER
  TECH
  VIEWER
}

enum SharedOrderStatus {
  OPEN
  ORDERED
  RECEIVED
  CANCELLED
}

model SharedOrderItem {
  id                     String            @id @default(uuid())
  productName            String
  sku                    String?
  vendorPartNumber       String?
  unitSize               String?
  categoryName           String?
  quantity               Int
  estimatedUnitPriceCents Int?
  notes                  String?
  status                 SharedOrderStatus @default(OPEN)
  requestedByTenant      String
  requestedByUserId      String?
  requestedByUserName    String
  orderedAt              DateTime?
  orderedByTenant        String?
  orderedByUserId        String?
  orderedByUserName      String?
  receivedAt             DateTime?
  receivedByTenant       String?
  receivedByUserId       String?
  receivedByUserName     String?
  cancelledAt            DateTime?
  cancelledByTenant      String?
  cancelledByUserId      String?
  cancelledByUserName    String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  @@index([status, createdAt])
  @@index([requestedByTenant, status])
}
