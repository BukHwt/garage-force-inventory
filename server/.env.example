# Database Connection
# Match these credentials with compose.yaml or your managed Postgres instance
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/garageforce?schema=public"
# Optional: explicit schema-per-tenant URLs (same DB, different schemas)
DATABASE_URL_MAIN="postgresql://postgres:postgres@localhost:5432/garageforce?schema=public"
DATABASE_URL_ADAM="postgresql://postgres:postgres@localhost:5432/garageforce?schema=adam"
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=garageforce
JWT_SECRET="change-me"

# Server Configuration
PORT=5000
NODE_ENV=development
